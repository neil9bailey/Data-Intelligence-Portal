# Local MVP settings. Copy to .env if you want to override defaults.
APP_NAME=Data Intelligence Portal
DATABASE_URL=sqlite:///data/data-intelligence-portal.sqlite
SQLITE_JOURNAL_MODE=DELETE
SQLITE_PERSISTENT_COPY_PATH=
SEED_REFERENCE_DATA=true
SEED_DEMO_DATA=false
AUTO_APPLY_CUSTOMER_PACKS=true

# Optional KRA live-demo AI settings. Leave disabled for offline deterministic local use.
# For approved local demos, set KRA_LLM_PROVIDER=openai_direct and provide the key
# through a local .env only. Azure deployments should use Key Vault secret references.
KRA_LLM_PROVIDER=disabled
KRA_API_KEY=
KRA_MODEL=gpt-5.4
KRA_MCP_MODE=local_registry

# Azure Container Apps / Entra live-test settings. Keep false for local Docker.
ENTRA_AUTH_ENABLED=false
ENTRA_ADMIN_GROUP_ID=
ENTRA_STANDARD_GROUP_ID=
DIP_OUTBOX_DIR=/app/data/outbox
DIP_PUBLIC_DOMAIN=dip.vendorlogic.io
DIP_REMOTE_HEALTH_URL=https://dip.vendorlogic.io/healthz
DIP_DEPLOYMENT_LABEL=local
